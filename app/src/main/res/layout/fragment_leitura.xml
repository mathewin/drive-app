<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DriveWin"
            android:textColor="@color/verde_neon"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="AGUARDANDO CORRIDA"
            android:textColor="@color/verde_neon"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="O card aparece automaticamente em cada oferta e some em poucos segundos"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="PERMISSOES"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Acessibilidade" />

            <TextView
                android:id="@+id/tvA11yLeitura"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Desativada"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnA11yLeitura"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minHeight="36dp"
                android:text="Conceder" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sobreposicao" />

            <TextView
                android:id="@+id/tvOverlayLeitura"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nao permitida"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnOverlayLeitura"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minHeight="36dp"
                android:text="Conceder" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Otimizacao de bateria" />

            <TextView
                android:id="@+id/tvBateriaLeitura"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ativa"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnBateriaLeitura"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minHeight="36dp"
                android:text="Isentar" />
        </LinearLayout>

        <Button
            android:id="@+id/btnIniciarLeitura"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="INICIAR LEITURA" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="ULTIMA DETECTADA"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#F5F5F5"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvLastApp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nenhuma corrida detectada ainda"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLastFare"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=""
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLastStats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text=""
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>

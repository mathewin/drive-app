<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AJUSTES"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Metas do card flutuante"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etMetaKmAj"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Meta minima R\$/km (ex: 1,50)"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/etMetaHAj"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Meta minima R\$/h (ex: 25)"
            android:inputType="numberDecimal" />

        <Button
            android:id="@+id/btnSalvarAj"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Salvar metas" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Historico"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnLimparHist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Apagar historico" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="DriveWin le a oferta da Uber, 99, inDriver e Bolt pela acessibilidade, calcula R\$/km e R\$/h e mostra em um card flutuante colorido por 7 segundos."
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
